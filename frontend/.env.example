# GapAtlas Frontend の環境変数の例。実値・秘密情報は書かないこと。
#
# SerpApi / Anthropic の API キーは **バックエンドのみ**が持つ。
# `VITE_` 接頭辞の値はビルド成果物へ埋め込まれるため、秘密情報を置いてはいけない。

# mock: バックエンドを起動せずに固定レスポンスで3画面を動かす(既定)
# live: VITE_API_BASE_URL の API を実際に呼ぶ
VITE_API_MODE=mock

# live モードで使う API のベース URL(docs/api.md の base path を含める)
VITE_API_BASE_URL=http://localhost:8000/api/v1
