# GapAtlas 環境変数の例。実値は書かないこと。

# ---- SerpApi ----
# fixture: tests/fixtures 配下の保存済みレスポンスを使用(外部通信なし)
# live   : SerpApi へ実際にリクエストする
SERPAPI_MODE=fixture
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_SECONDS=8
SERPAPI_MAX_RETRIES=2

# ---- LLM ----
# stub     : 決定的なスタブ応答を返す(単体テスト・開発用)
# anthropic: Anthropic API を直接呼び出す。`make setup`(uv sync --all-extras)で
#            llm extra の anthropic パッケージが入っていること
LLM_MODE=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_RETRIES=2

# ---- AWS ----
# memory: プロセス内メモリ。AWS へ接続しない(既定)
# aws   : DynamoDB と S3 へ書き込む。`make setup`(uv sync --all-extras)が必要
PERSISTENCE_MODE=memory
AWS_REGION=ap-northeast-1
DYNAMODB_TABLE_NAME=gapatlas
S3_BUCKET_NAME=gapatlas-data
SQS_QUEUE_URL=

# ---- App ----
# DEBUG / INFO / WARNING / ERROR / CRITICAL のいずれか
LOG_LEVEL=INFO
# CORS を許可する Frontend origin(カンマ区切り)
CORS_ALLOWED_ORIGINS=http://localhost:5173
